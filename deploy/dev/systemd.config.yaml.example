# Copy to the WorkingDirectory of yuuka-dev.service as config.yaml.
# BASE_URL must match the browser URL, including HTTPS, for host-only auth cookies and CSRF.
HOST: "127.0.0.1"
PORT: 3403
DB_PATH: "./data/yuuka.db"
REDIS_URL: "redis://127.0.0.1:6379/15"
BASE_URL: "https://yuuka-dev.sk-9.net"
# Login: the standard sk-account over OIDC (client "yuuka-dev"). Put the secret from
# `sk-account oidc new-secret` here and register the client in sk-account's oidc-clients.toml.
OIDC_INTERNAL_URL: "http://127.0.0.1:3100"
OIDC_CLIENT_ID: "yuuka-dev"
OIDC_CLIENT_SECRET: ""
# Server-side TTS for devices without WebGPU (deploy/tts/yuuka-tts.service, shared with production).
TTS_SERVER_URL: "http://127.0.0.1:3410"
# Ed25519 key that signs requests to the TTS server (clients/pwa/server/tts/keygen.ts; use a different key than production).
# TTS_SIGNING_KEY: ""
