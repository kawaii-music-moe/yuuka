# ==============================================================================
# Yuuka 開発(dev) インスタンス — 非機密の起動パラメータ（テンプレート）
#   cp instance.env.example instance.env して環境に合わせて編集する。
#   ※ この値に "$" を含めないこと（compose が変数展開してしまうため）
# ==============================================================================

COMPOSE_PROJECT_NAME=yuuka-dev

# Docker ブリッジのサブネットを固定する（#51）。prod（172.28.0.0/24）と重複しない値にすること。
# サブネットの先頭アドレスが既定で Docker のゲートウェイ IP になる。
DOCKER_NET_SUBNET=172.29.0.0/24

# dev は基本 127.0.0.1 経由のみで TRUSTED_PROXIES は必須ではないが、prod と構成を揃えておく
# （将来リバースプロキシ配下に置く場合や cutover-dev-rust.sh 経由の検証でも整合させるため）。
TRUSTED_PROXIES=172.29.0.1

# ホスト公開ポート（本番 7854 等と衝突させない）
HOST_PORT=7855
# 開発はローカルのみで十分なため 127.0.0.1
BIND_ADDR=127.0.0.1

PUID=1000
PGID=1000

# dev 専用の空データディレクトリ（初回起動時に新規 DB が作られる）
DATA_DIR=/absolute/path/to/yuuka/deploy/dev/data
CONFIG_FILE=/absolute/path/to/yuuka/deploy/dev/config.yaml

# 配布 Windows exe（/api/desktop/download）に焼き込む公開 URL。
# 未設定ならローカル既定 http://127.0.0.1:7854 にフォールバックする。
YUUKA_API_BASE=https://yuuka-dev.example.com
