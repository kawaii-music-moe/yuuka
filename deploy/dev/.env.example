# ==============================================================================
# dev フロント（Vite）— vite.compose.yml 用パラメータ（テンプレート）
#   cp deploy/dev/.env.example deploy/dev/.env して環境に合わせて編集する。
#   docker compose が vite.compose.yml と同じディレクトリの `.env` を自動で読み込む。
#   `.env` は .gitignore 済（追跡されるのはこの .example のみ）。機密値は入れない。
#
#   ※ deploy/dev/instance.env（dev API コンテナ用・instance.sh が読む）とは別ファイル。
#     ここに COMPOSE_PROJECT_NAME は書かない（プロジェクト名は vite.compose.yml の
#     `name: yuuka-dev-vite` で固定。API 側 yuuka-dev と混ざらないようにするため）。
#
#   各変数は未設定なら「既定」の値になる（下は既定値を明示したもの。変えたい行だけ有効にする）。
# ==============================================================================

# Vite を動かすソースツリー（bind マウント元。node_modules もここに作られる）。
#   既定: リポジトリルート（vite.compose.yml から見た ../..）。
#   別の worktree / clone を使う場合だけ絶対パスで指定する。
# VITE_SRC_DIR=/absolute/path/to/yuuka

# コンテナ内 Vite の実行ユーザー（ソースツリーの所有者に合わせる: `id -u` / `id -g`）。
#   既定 1000:1000。ホストのグループが 1000 でない場合は VITE_GID を合わせること。
# VITE_UID=1000
# VITE_GID=1000

# Vite の待受（ホスト直。network_mode: host のため衝突しないポートを選ぶ）。
#   既定 127.0.0.1:7855（トンネル/リバースプロキシはここへ向ける）。
#   dev API（instance.env の HOST_PORT=7856）とは別ポート。
# VITE_BIND_ADDR=127.0.0.1
# VITE_PORT=7855

# /api・/ws/chat の proxy 先 = dev API（deploy/dev/instance.env の HOST_PORT に合わせる）。
#   既定 http://127.0.0.1:7856
# VITE_API_TARGET=http://127.0.0.1:7856

# トンネル経由でアクセスする公開ホスト名（Vite の allowedHosts に追加。カンマ区切り可）。
#   既定 yuuka-dev.kawaii-music.moe（未設定のとき）。トンネルを使わない環境では
#   `VITE_ALLOWED_HOST=`（空で明示）にすると localhost 系のみ許可になる。
# VITE_ALLOWED_HOST=yuuka-dev.kawaii-music.moe
