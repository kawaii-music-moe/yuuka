# サーバーでの音声生成（GPU の無い端末向け・clients/pwa/server/tts）。本番と dev で 1 つを共有する
# （CPU を 1 生成で使い切るため）。%h/yuuka はチェックアウトの場所、node のパスは command -v node に合わせる:
#   cp deploy/systemd/yuuka-tts.service.example ~/.config/systemd/user/yuuka-tts.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now yuuka-tts.service
# yuuka（本番・dev）の config.yaml に TTS_SERVER_URL: "http://127.0.0.1:3410" を書くと中継が有効になる。
# 別のマシンに置くときは TTS_HOST と TTS_VERIFY_KEYS（yuuka の TTS_SIGNING_KEY の公開鍵）を設定する（deploy/README.md）。
[Unit]
Description=Yuuka server-side TTS (Irodori-TTS on CPU)
After=network.target

[Service]
WorkingDirectory=%h/yuuka/clients/pwa
Environment=TTS_MODEL_DIR=%h/yuuka/data/tts-models/<バージョン>
Environment=TTS_PORT=3410
# 署名を確かめる公開鍵（server/tts/keygen.ts・本番と dev の分をカンマ区切り）。設定すると署名の無い要求を断る。
#Environment=TTS_VERIFY_KEYS=
# yuuka 本体のために 1 コア残す。10 分使われなければモデル（約 3.7 GB）を解放する。
Environment=TTS_THREADS=3
Environment=TTS_IDLE_MINUTES=10
ExecStart=/usr/bin/node --import tsx server/tts/server.ts
Restart=on-failure
RestartSec=5
# 生成中のピークは 5 GB 前後。超えたら止めて再起動する（ホストのメモリを守る）。
MemoryMax=6G

# ─── 隔離（読むのは clients/pwa とモデルだけ。tsx のキャッシュは /tmp に書く） ───
ProtectHome=tmpfs
BindReadOnlyPaths=%h/yuuka/clients/pwa %h/yuuka/data/tts-models
BindReadOnlyPaths=-%h/.nix-profile -%h/.local/state/nix
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Node は JIT を使うので MemoryDenyWriteExecute は付けない。

[Install]
WantedBy=default.target
