# 本番の yuuka（ユーザー systemd）。リポジトリのチェックアウトを作業ディレクトリにして動かす。
#   %h/yuuka はチェックアウトの場所に合わせて書き換える（%h はホームディレクトリ）。
#   cp deploy/systemd/yuuka.service.example ~/.config/systemd/user/yuuka.service
#   systemctl --user daemon-reload && systemctl --user enable --now yuuka.service
#   ログアウト後も動かすなら: loginctl enable-linger "$USER"
# 設定は <チェックアウト>/config.yaml ではなく deploy/prod/config.yaml を読ませたいので、
# 作業ディレクトリ直下の config.yaml を deploy/prod/config.yaml へのシンボリックリンクにしておく。
# 暗号化シークレットは deploy/prod/secret.key に置き、run-yuuka.sh が環境変数にして起動する。
[Unit]
Description=Yuuka
Requires=yuuka-redis.service
After=network.target yuuka-redis.service

[Service]
Type=simple
WorkingDirectory=%h/yuuka
Environment=TZ=Asia/Tokyo
# ブラウザ操作に使う Chromium（既知のパスに無いときだけ指定する）。
#Environment=CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# Chromium の同時起動数の上限（対話セッションと 1 回きりの起動の合計）。未設定なら上限なし。
#Environment=YUUKA_BROWSER_MAX_PROCESSES=3
ExecStart=%h/yuuka/deploy/prod/run-yuuka.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# ─── 資源の上限（Chromium もこの枠に入る。ホストのメモリに合わせて変える） ───
MemoryHigh=2G
MemoryMax=3G
TasksMax=512

# ─── 隔離（Bot やブラウザ操作が破られてもホームの他の場所に届かないようにする） ───
# ホームは空に見せ、チェックアウトは読み取りのみ、data/ だけ書き込める。
ProtectHome=tmpfs
BindReadOnlyPaths=%h/yuuka
BindPaths=%h/yuuka/data
# Nix で入れた Chromium（~/.nix-profile）や puppeteer の Chrome を使うとき用（無ければ無視される）。
BindReadOnlyPaths=-%h/.nix-profile -%h/.local/state/nix -%h/.cache/puppeteer
ProtectSystem=strict
PrivateTmp=yes
# Chromium の既定プロファイル（1 回きりの起動で使う）を、ホームではなく /tmp に置く。
Environment=XDG_CONFIG_HOME=/tmp/xdg/config XDG_CACHE_HOME=/tmp/xdg/cache
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Chromium のサンドボックスは名前空間と JIT を使うので、RestrictNamespaces・
# MemoryDenyWriteExecute は付けない。

[Install]
WantedBy=default.target
