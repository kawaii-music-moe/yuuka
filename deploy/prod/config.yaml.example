# ==============================================================================
# Yuuka 本番(prod) インスタンス設定 — Docker 運用版（テンプレート）
#   cp config.yaml.example config.yaml して編集する。config.yaml は .gitignore 済。
#   暗号化シークレットはここに書かず deploy/prod/secret.key（環境変数注入）に置く。
# ==============================================================================

# DB（コンテナ内パス。/app/data はホストの実 data/ を bind マウント）
DB_PATH: "./data/yuuka.db"

# Redis はインスタンス専用コンテナ（compose の service 名 "redis"）へ接続
REDIS_URL: "redis://redis:6379"

# 運用チューニング（未設定なら既定値。不正値は起動時に警告して既定値を使う。詳細は example.yaml）
REMINDER_CRON: "* * * * *"
# SYNAPSE_RECALL_K: 5
# SYNAPSE_RECENCY_WEIGHT: 0.15
# SYNAPSE_RECENCY_HALFLIFE_HOURS: 18
# DESKTOP_TOKEN_TTL_DAYS: 90
# DESKTOP_DEVICE_CODE_TTL_SEC: 600

# 管理画面（コンテナ内待受。ホスト公開ポートは instance.env の HOST_PORT）
PORT: 7854
HOST: "0.0.0.0"

# ログインは sk-account に委ねる（公開 URL と、サーバーから認可コードを交換する内部 URL）
SK_ACCOUNT_URL: "https://account.sk-9.net"
SK_ACCOUNT_INTERNAL_URL: "http://127.0.0.1:3100"

# Google OAuth2 システム共通設定（取得した値を設定。Secret は機密）
GOOGLE_CLIENT_ID: "your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET: "your-google-oauth-client-secret"

# 外部公開ベースURL（Cloudflare Tunnel 等で公開する本番ドメイン）
BASE_URL: "https://yuuka.example.com"

PRIVACY_POLICY_URL: "/privacy"
TERMS_URL: "/terms"
GOOGLE_SITE_VERIFICATION: ""
