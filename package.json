{
  "name": "yuuka",
  "version": "2.0.0",
  "description": "Discord Gemini 秘書ボット & Web管理ダッシュボード",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build:front": "vite build --config frontend/vite.config.ts",
    "typecheck:front": "svelte-check --tsconfig frontend/tsconfig.json",
    "dev:client:mock": "node scripts/dev-client-mock.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build": "cargo build --release --bin yuuka && pnpm build:front",
    "lint": "biome check frontend/src scripts",
    "lint:fix": "biome check --write frontend/src scripts",
    "check": "pnpm typecheck:front && pnpm lint",
    "deploy": "deploy/instance.sh prod update",
    "deploy:rollback": "deploy/instance.sh prod rollback",
    "deploy:verify": "deploy/instance.sh prod verify",
    "deploy:logs": "deploy/instance.sh prod logs -f",
    "deploy:logs:dev": "deploy/instance.sh dev logs -f",
    "deploy:down": "deploy/instance.sh prod down",
    "deploy:ps": "deploy/instance.sh prod ps"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.19.19",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "pnpm": {
    "comment": "推移的依存の既知脆弱性をパッチ版へ固定。",
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
