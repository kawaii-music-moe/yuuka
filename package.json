{
  "name": "yuuka",
  "version": "2.0.0",
  "description": "Discord Gemini \u79d8\u66f8\u30dc\u30c3\u30c8 & Web\u7ba1\u7406\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "deploy/instance.sh dev hot",
    "dev:build": "deploy/instance.sh dev hot --build",
    "dev:host": "tsx watch src/index.ts",
    "dev:front": "vite --config frontend/vite.config.ts",
    "dev:all": "concurrently -k \"pnpm dev:host\" \"pnpm dev:front\"",
    "build:front": "vite build --config frontend/vite.config.ts",
    "typecheck:front": "svelte-check --tsconfig frontend/tsconfig.json",
    "dev:admin": "pnpm dev:front",
    "dev:client:mock": "node scripts/dev-client-mock.mjs",
    "dev:frontend": "node scripts/dev-frontend.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build": "pnpm build:pwa && cargo build --release && mkdir -p dist/bin dist/assets && cp target/release/yuuka dist/bin/ && cp target/release/yuuka-crawler dist/bin/ && cp target/release/yuuka-synapse dist/bin/ && cp -r src/assets/. dist/assets/ && pnpm exec vite build --config frontend/vite.config.ts && cp -r src/public/pwa dist/public/",
    "start": "./dist/bin/yuuka",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint",
    "deploy": "deploy/instance.sh prod update",
    "deploy:dev": "deploy/instance.sh dev update",
    "deploy:rollback": "deploy/instance.sh prod rollback",
    "deploy:rollback:dev": "deploy/instance.sh dev rollback",
    "deploy:verify": "deploy/instance.sh prod verify",
    "deploy:logs": "deploy/instance.sh prod logs -f",
    "deploy:logs:dev": "deploy/instance.sh dev logs -f",
    "deploy:down": "deploy/instance.sh prod down",
    "deploy:ps": "deploy/instance.sh prod ps"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.5.1",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^25.1.0",
    "redis": "^4.7.1",
    "rss-parser": "^3.13.0",
    "ws": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "concurrently": "^10.0.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "comment": "\u63a8\u79fb\u7684\u4f9d\u5b58\u306e\u65e2\u77e5\u8106\u5f31\u6027\u3092\u30d1\u30c3\u30c1\u7248\u3078\u56fa\u5b9a\u3002\u4e92\u63db\u6027\u7dad\u6301\u306e\u305f\u3081 undici \u306f discord.js \u304c\u524d\u63d0\u3068\u3059\u308b 6.x \u7cfb\u5185\u306e\u4fee\u6b63\u7248\u306b\u7559\u3081\u308b\uff08\u30e1\u30b8\u30e3\u30fc\u8de8\u304e\u3092\u907f\u3051\u308b\uff09\u3002uuid \u3082\u4fee\u6b63\u7248\u76f4\u8fd1\u306e\u7cfb\u7d71\u306b\u56fa\u5b9a\u3002",
    "overrides": {
      "undici@<6.27.0": "^6.27.0",
      "uuid@<11.1.1": "^11.1.1",
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
