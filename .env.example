# ==============================================================================
# Yuuka - 環境変数（機密設定）リファレンス
#
# 【重要】LLM_PROVIDER / LLM_MODEL 以外は .env ファイルを自動読込しません
# その他の値は、実際にプロセスの環境変数として渡さないと反映されません。
#   cp .env.example .env   # まず値を編集
#   set -a && source .env && set +a && cargo run --bin yuuka   # 起動前に export して読み込む
# systemd 等で運用する場合は Environment= で直接渡す方が確実です（source 忘れを防げます）。
# 本番では deploy/prod/secret.key を deploy/prod/run-yuuka.sh が環境変数にします
# （YUUKA_ENCRYPTION_SECRET のみ。詳細は docs/guide/deployment.md）。
# .env 自体は git 管理外です。
#
# 「config.yaml でも可」と書いた項目は、作業ディレクトリの config.yaml に同じキー名で書いても
# 読み込まれます（config.yaml が環境変数より優先）。それ以外はプロセスの環境変数でのみ有効です。
# ==============================================================================

# AIの既定値（この2項目は起動時に.envから自動読込。export済み環境変数を優先）。
# 現在対応するプロバイダはgeminiのみ。Bot設定画面で保存した値が既定値より優先されます。
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# 保存時暗号化のマスターシークレット【必須】
# DBに保存する Discordトークン・APIキー・パスワードマネージャ等の暗号化に使う
# マスターシークレットです。未設定の場合は起動しません。
# 十分に長いランダム文字列を設定してください。 生成例: openssl rand -base64 48
YUUKA_ENCRYPTION_SECRET=

# YUUKA_ENCRYPTION_SECRET のローテーション用新キー。設定して起動すると全暗号化データが
# 新キーで再暗号化されます。完了後 YUUKA_ENCRYPTION_SECRET に新キーの値を設定し、この項目を
# 削除して再起動してください（手順は仕様書 §6.2.1 参照）。
# YUUKA_ENCRYPTION_SECRET_NEW=

# 外部公開URL（本番では必須）。OAuth redirect_uri・Webhook URL・Cookieのハードニング判定に
# 使用します。これが https:// で始まる場合、セッションCookieは常に Secure + __Host- 付きで発行され、
# 非Secure Cookieは受理されません。未設定だと OAuth は localhost 以外で動作しません。
# 例: BASE_URL=https://yuuka.example.com
# BASE_URL=

# 信頼するリバースプロキシのIP（カンマ区切り・任意）。設定した場合のみ、直前のpeerがこのリストに
# 含まれるリクエストの X-Forwarded-For からクライアント実IPを解決します（ログインのレート制限等）。
# 未設定時は接続元IP（socket.remoteAddress）のみを信頼します（XFFは偽装可能なため無視）。
# 例: TRUSTED_PROXIES=127.0.0.1,10.0.0.2
# TRUSTED_PROXIES=

# 新規インスタンスの DB ブートストラップ opt-in（既定 off）。DB_PATH が指す DB ファイルが
# 無いと通常は即エラーで起動失敗します（パス誤設定で空DBを作らないための安全策）。まっさらな
# インスタンスの初回起動のみ 1 を設定すると、無ければ新規作成して migrations を適用します。
# 起動確認後はコメントに戻してください（issue #55 / PR #64）。
# YUUKA_INIT_DB=

# デスクトップのボタン往復検証（通常は無効）。有効時は /__demo_buttons に確認ボタンを返す。
# DESKTOP_DEMO_COMPONENTS=false

# ─── シナプス認知アーキテクチャ（schema v10 / R0・R1。docs/architecture/architecture_v2.md §13） ───
# R0/R1 のコンポーネント（ツール実績記録・シナプス抽出・L2 想起・メトリクス）は yuuka-synapse
# crate としてバックエンドにインプロセスで組み込み済みで、常時有効です。
# L2 想起のチューニング値は Node 版と同じキー名で config.yaml または環境変数から読み込みます
# （config.yaml が優先。不正値は起動時に警告を出して既定値を使います）。
# SYNAPSE_RECALL_K=5                 # 想起する記憶の件数（1 以上）
# SYNAPSE_RECENCY_WEIGHT=0.15        # 最近の記憶を持ち上げる重み（0 で無効）
# SYNAPSE_RECENCY_HALFLIFE_HOURS=18  # 上の重みが半分になるまでの時間（0 で無効）

# ─── サーバー基本設定（config.yaml でも可） ───
# HOST=127.0.0.1                     # 待ち受けアドレス
# PORT=3000                          # 待ち受けポート（0 は不可）
# DB_PATH=./data/yuuka.db            # SQLite DB のパス（無いと起動失敗。YUUKA_INIT_DB 参照）
# SESSION_TTL_DAYS=7                 # ログインセッションの有効日数（1 以上）
# REDIS_URL=redis://127.0.0.1:6379
# ADMIN_DISCORD_IDS=                 # 管理者として新規作成する Discord ID（カンマ区切り。初回ログイン前に指定。未設定なら全員 User）
# REMINDER_CRON="* * * * *"          # リマインダー走査の cron 式（不正値は警告して既定）

# ─── ログイン（OIDC。config.yaml でも可） ───
# 本人認証は OIDC プロバイダーが担います。OIDC_ISSUER を省略すると標準の sk-account を使います。
# OIDC_CLIENT_SECRET が未設定だとログインできません。
# OIDC_ISSUER=https://account.sk-9.net
# OIDC_INTERNAL_URL=                 # サーバーからプロバイダーへ問い合わせる先（未設定は issuer。同一ホスト運用時など）
# OIDC_CLIENT_ID=yuuka
# OIDC_CLIENT_SECRET=
# OIDC_SCOPE="openid profile discord"
# OIDC_DISCORD_ID_CLAIM=discord_id   # ID トークン内で Discord ID を持つ claim 名
# OIDC_LABEL=                        # ログインボタンの表示名（既定: 標準なら sk-9 Account、他は issuer のホスト名）

# ─── Google 連携（任意。config.yaml でも可。未設定なら Google 連携は無効） ───
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SITE_VERIFICATION=          # Google Search Console の所有権確認トークン

# ─── 公開ページのリンク（任意。config.yaml でも可） ───
# PRIVACY_POLICY_URL=
# TERMS_URL=

# ─── サーバーでの音声生成（任意。config.yaml でも可。deploy/README.md 参照） ───
# TTS_SERVER_URL を設定すると、音声生成サーバー（yuuka-tts.service）へ中継します。パスは付けません。
# TTS_SIGNING_KEY は要求に付ける Ed25519 署名の秘密鍵（32 バイトの seed を base64）。
# clients/pwa/server/tts/keygen.ts で作り、公開鍵は音声生成サーバーの TTS_VERIFY_KEYS に設定します。
# 形式が不正だと起動しません。
# TTS_SERVER_URL=http://127.0.0.1:3410
# TTS_SIGNING_KEY=

# ─── デスクトップクライアント（config.yaml でも可。DESKTOP_DOWNLOAD_DIR のみ環境変数専用） ───
# DESKTOP_MAX_UPLOAD_MB=20           # 添付の上限（MB）
# DESKTOP_TOKEN_TTL_DAYS=90          # デスクトップ用トークンの有効日数（1〜36500）
# DESKTOP_DEVICE_CODE_TTL_SEC=600    # デバイスコードの有効秒数（1〜86400）
# DESKTOP_DOWNLOAD_DIR=./dist/downloads   # 配布する yuuka-desktop.exe の置き場所
# ※ クライアント側の接続先 YUUKA_API_BASE は実行時ではなくデスクトップクライアントのビルド時に渡します。

# ─── Rust 常駐処理の起動ゲート（環境変数専用。1/true/yes で有効） ───
# 本番では deploy/prod/run-yuuka.sh が両方 1 にしています。
# YUUKA_RUST_DISCORD 未設定だと Bot は Discord に接続せず、REST 送信（通知・DM）だけ動きます。
# YUUKA_RUST_CRON=1                  # リマインダー等の定期ジョブ
# YUUKA_RUST_DISCORD=1               # Discord ゲートウェイ（二重応答を避けるため 1 プロセスだけで有効に）

# ─── ブラウザ操作・グラフ描画（任意・環境変数専用） ───
# CHROME_EXECUTABLE_PATH=            # Chrome/Chromium の実行ファイル（未設定は既知のパスから探す）
# YUUKA_BROWSER_NO_SANDBOX=1         # Chrome を --no-sandbox で起動（root 実行時は自動で付く）
# YUUKA_BROWSER_MAX_PROCESSES=3      # Chrome の同時起動数の上限（対話セッション＋1 回きりの起動の合計）。
#                                    # 未設定・0 は上限なし。埋まっていると最大 30 秒待ち、空かなければエラーを返す
# YUUKA_CHART_FONT=                  # グラフ描画に使うフォントファイル（.ttf/.otf/.ttc）
