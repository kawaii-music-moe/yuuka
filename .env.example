# ==============================================================================
# Yuuka - 環境変数（機密設定）リファレンス
#
# 【重要】バックエンド（Rust・crates/yuuka-core の Config）は .env ファイルを自動読込しません
# （dotenv 非対応）。ここに書いた値は、実際にプロセスの環境変数として渡さないと反映されません。
#   cp .env.example .env   # まず値を編集
#   set -a && source .env && set +a && cargo run --bin yuuka   # 起動前に export して読み込む
# systemd 等で運用する場合は Environment= で直接渡す方が確実です（source 忘れを防げます）。
# Docker デプロイでは deploy/<instance>/secret.key から自動的に環境変数化されます
# （YUUKA_ENCRYPTION_SECRET のみ。詳細は docs/guide/deployment.md）。
# .env 自体は git 管理外です。
# ==============================================================================

# 保存時暗号化のマスターシークレット【必須】
# DBに保存する Discordトークン・APIキー・パスワードマネージャ等の暗号化に使う
# マスターシークレットです。未設定の場合は起動しません。
# 十分に長いランダム文字列を設定してください。 生成例: openssl rand -base64 48
YUUKA_ENCRYPTION_SECRET=

# YUUKA_ENCRYPTION_SECRET のローテーション用新キー。設定して起動すると全暗号化データが
# 新キーで再暗号化されます。完了後 YUUKA_ENCRYPTION_SECRET に新キーの値を設定し、この項目を
# 削除して再起動してください（手順は仕様書 §6.2.1 参照）。
# YUUKA_ENCRYPTION_SECRET_NEW=

# 外部公開URL（本番では必須）。OAuth redirect_uri・Webhook URL・Cookieのハードニング判定に
# 使用します。これが https:// で始まる場合、セッションCookieは常に Secure + __Host- 付きで発行され、
# 非Secure Cookieは受理されません。未設定だと OAuth は localhost 以外で動作しません。
# 例: BASE_URL=https://yuuka.example.com
# BASE_URL=

# 信頼するリバースプロキシのIP（カンマ区切り・任意）。設定した場合のみ、直前のpeerがこのリストに
# 含まれるリクエストの X-Forwarded-For からクライアント実IPを解決します（ログインのレート制限等）。
# 未設定時は接続元IP（socket.remoteAddress）のみを信頼します（XFFは偽装可能なため無視）。
# 例: TRUSTED_PROXIES=127.0.0.1,10.0.0.2
# TRUSTED_PROXIES=

# 新規インスタンスの DB ブートストラップ opt-in（既定 off）。DB_PATH が指す DB ファイルが
# 無いと通常は即エラーで起動失敗します（パス誤設定で空DBを作らないための安全策）。まっさらな
# インスタンスの初回起動のみ 1 を設定すると、無ければ新規作成して migrations を適用します。
# 起動確認後はコメントに戻してください（issue #55 / PR #64）。
# YUUKA_INIT_DB=

# デスクトップのボタン往復検証（通常は無効）。有効時は /__demo_buttons に確認ボタンを返す。
# DESKTOP_DEMO_COMPONENTS=false

# ─── シナプス認知アーキテクチャ（schema v10 / R0・R1。docs/architecture/architecture_v2.md §13） ───
# R0/R1 のコンポーネント（ツール実績記録・シナプス抽出・L2 想起・メトリクス）は yuuka-synapse
# crate としてバックエンドにインプロセスで組み込み済みで、常時有効です。
# L2 想起のチューニング値は Node 版と同じキー名で config.yaml または環境変数から読み込みます
# （config.yaml が優先。不正値は起動時に警告を出して既定値を使います）。
# SYNAPSE_RECALL_K=5                 # 想起する記憶の件数（1 以上）
# SYNAPSE_RECENCY_WEIGHT=0.15        # 最近の記憶を持ち上げる重み（0 で無効）
# SYNAPSE_RECENCY_HALFLIFE_HOURS=18  # 上の重みが半分になるまでの時間（0 で無効）
